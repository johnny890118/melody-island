    "clsx": "^2.1.1",
    "firebase": "^11.0.2",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
